LICENSE
README.md

# ---- srs-review-ai: never bake local data into an image ----
# The image is pushed to a PUBLIC Docker Hub repo and `COPY . .` takes every
# path not listed here. server/ holds runtime data from local runs: uploaded
# SRS documents (.uploads), cached review results (.cache), share links,
# submissions and class rosters. On the VPS those live in the /data volume.
**/.env.*
!**/.env.example
.uploads
.cache
.shares
.submissions
.classes
*-*.pdf
*.docmap.json
*.meta.json
*.render.*.png
*.log
*.bat

# Dev-only: tests, linters' caches, helper scripts and deploy files.
tests
.pytest_cache
.ruff_cache
.mypy_cache
tool_summarize_batch.py
requirements-dev.txt
Caddyfile
README.Docker.md
