# Copy to server/.env and fill in. server/.env is git-ignored — keep it that way.
# Get a free key at https://aistudio.google.com/apikey (no credit card needed).
#
# WARNING (research 08): the Gemini FREE tier may use your content to improve
# Google products and human reviewers can read it. Do not upload a real client's
# confidential SRS. Say this in the app's privacy note.

# One key, or several separated by commas/newlines. Google meters the free
# tier per key, so N keys carry N quotas and a 429 rotates to the next one.
GEMINI_API_KEY=
# Seconds a key that answered 429 is parked (default 900 = 15 min).
PROVIDER_KEY_COOLDOWN_S=

# Current low-cost multimodal models (checked on ai.google.dev, 2026-09-09).
# The 2.5 series the original research picked is now LEGACY — don't start there.
# `gemini-3.5-flash-lite` lists document parsing as a target workload;
# `gemini-3.1-flash-lite` is the stable long-term option used as the fallback.
# Confirm YOUR project's free-tier quota in AI Studio: Google cut free limits in
# late 2025 and they vary per model.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=
GOOGLE_API_KEY_6=
GOOGLE_API_KEY_7=
GOOGLE_API_KEY_8=

# OpenAI-compatible providers. LLM_MODEL overrides the provider-specific model.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# true => never touch the network; answer from the deterministic mock provider.
MOCK_MODE=false

# Bump to invalidate the review cache after editing the prompt.
PROMPT_VERSION=p1

RATE_LIMIT_PER_DAY=50
FUZZY_THRESHOLD=0.92
REQUEST_TIMEOUT_S=90

# Legacy shared secret for non-review endpoints such as admin/config and upload routes.
# Review endpoints authenticate Firebase ID tokens instead.
APP_TOKEN=

# Must match the Firebase project configured in the Mobile app.
FIREBASE_PROJECT_ID=srs-review-ai-ff68b
# Comma-separated Firebase Auth UIDs allowed to publish Remote Config.
REMOTE_CONFIG_ADMIN_UIDS=
# In Docker Compose, place a private Admin SDK service-account JSON at
# server/firebase-admin.json (git-ignored) or set GOOGLE_APPLICATION_CREDENTIALS
# to its container path. Never commit this credential file.
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-admin.json

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PostgreSQL. DATABASE_URL is what the server uses when run with the venv
# (127.0.0.1, not localhost: on Windows localhost may try ::1 first and hang).
# Inside Docker Compose the backend gets DATABASE_HOST=db, which swaps only the
# host/port, so this one line serves both. @ : / in the password must be
# URL-encoded HERE (%40 %3A %2F) but NOT in POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://postgres:<password-url-encoded>@127.0.0.1:5433/prm_srs_ai
# Read by the docker-compose `db` container to create the database on first start.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=prm_srs_ai

# Presigned-upload storage. Point SRS_UPLOAD_DIR at a network mount or cloud
# bucket when the proxy outgrows local disk. SRS_MAX_UPLOAD_BYTES enforces the
# hard ceiling on a single PUT body (Vercel caps request bodies at ~4.5 MB, so
# documents larger than that go through the presigned-upload flow instead).
SRS_UPLOAD_DIR=
SRS_MAX_UPLOAD_BYTES=41943040

CORS_ORIGINS=*
