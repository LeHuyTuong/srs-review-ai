# Copy to .env in the repository root. Never commit the populated file.
# Flutter receives only the client allowlist through tools/flutter_env.py.

# Firebase client API keys, from each app's Firebase SDK configuration.
MOBILE_FIREBASE_WEB_API_KEY=
MOBILE_FIREBASE_ANDROID_API_KEY=
# Admin Web dùng chung Web app với mobile web (project srs-ai-prm) nên key của
# nó cũng là key của Web app đó.
ADMIN_WEB_FIREBASE_WEB_API_KEY=
DESKTOP_FIREBASE_ANDROID_API_KEY=

# Optional. OAuth client id loai Web cho Google Sign-In tren web cua mobile.
# De trong thi runner lay client_type 3 trong
# mobile/android/app/google-services.json.example.
MOBILE_GOOGLE_SIGN_IN_WEB_CLIENT_ID=

# Server only. Never add these to Flutter assets or Dart defines.
GEMINI_API_KEY=
APP_TOKEN=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional server settings. OS environment variables take precedence.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
MOCK_MODE=false
RATE_LIMIT_PER_DAY=50
REQUEST_TIMEOUT_S=90
