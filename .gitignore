# ---------- Secrets (NEVER commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# ---------- Flutter / Dart ----------
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/ios/Pods/
app/macos/Pods/
app/windows/flutter/ephemeral/
app/linux/flutter/ephemeral/
app/android/.gradle/
app/android/local.properties
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/**/*.g.dart
app/**/*.freezed.dart
app/**/*.mocks.dart
*.iml

# ---------- Python / FastAPI ----------
server/.venv/
server/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
server/.cache/

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/launch.json

# ---------- Local artifacts ----------
/samples/private/
*.log
coverage/
# flutter test --file-reporter output (CI annotator input; local runs too)
/app/test_report.json

# presigned-upload landing zone (dev default; never commit uploaded documents)
server/.uploads/

# ---------- Runtime artifacts (share-link bodies written by the server) ----------
server/.shares/

# ---------- Uploaded document cache (docmap/meta/page renders beside server) ----------
server/*-*.pdf
server/*.docmap.json
server/*.meta.json
server/*.render.*.png

node_modules/

# Skill draw.io cá nhân — công cụ tác giả, không phải phần app/pipeline chấm, giữ local
# (2026-09-25: file zip là bản nén gốc, thêm vào đây vì `git add -A` sẽ đưa nó
# lên theo dõi dù cây đã giải nén bên dưới đã bị ignore — đẩy 1 file .zip là
# đẩy nguyên bộ skill lên origin.)
skills.zip
skills/README.md
skills/activity-diagram/
skills/architecture-diagram/
skills/communication-diagram/
skills/component-diagram/
skills/conceptual-erd/
skills/package-diagram/
skills/sequence-class-diagram/
skills/state-machine-diagram/
skills/use-case-diagram/
skills/diagram-builder/

# Sau khi giải nén skills.zip, cây thực tế nằm ở skills/skills/ (lồi một
# cấp) kèm thư mục rác __MACOSX/ — hai mẫu trên không che được. Chúng là bản
# sao local của các skill draw.io, không phải adapter mà repo theo dõi
# (skills/srs-reviewer + skills/sds-reviewer vẫn được track).
skills/skills/
skills/__MACOSX/

# 2026-09-25: hai adapter Claude skill không còn được theo dõi trong repo nữa
# (bản local ở skills/skills/ đã kiểm là byte-giống-hệt bản đã xoá). Thêm ở đây
# để lần giải nén sau không biến chúng thành untracked noise và không có cơ hội
# lọt vào một `git add -A`.
skills/srs-reviewer/
skills/sds-reviewer/

# ---------- Local run logs and hand-captured CLI output ----------
# a1/a2.out.txt + full.err.txt were one-off captures while debugging the vision
# chain; dev_web.out/err come from app/tool/dev_web.ps1 runs. All machine output,
# not evidence — evidence lives in docs/evidence/ with a date in its name.
# Patterns kept narrow on purpose: a blanket *.txt would swallow the notes-*.json
# neighbours and review-rules material.
/app/*.out.txt
/app/*.err.txt
/app/tool/logs/

# Provider replies cached by docs/evidence/scripts/probe_vision_reality.py.
# Regenerated on the next run; the numbers it produced are the committed JSON.
/docs/evidence/scripts/.vision-probe-cache.json

# Freebuff client metadata (workspace-scoped project id, 37 bytes). Not repo
# content — ignored rather than deleted so the client keeps its project mapping.
/.freebuff/

# Submission records written by the server (parity with server/.shares/ above).
# Runtime data on the host, never source: plan 9 §7 — on Vercel this directory
# does not survive a cold start, which is exactly why it stays ignored.
server/.submissions/

# Class rosters (plan 12 WP2) — same runtime-data posture as .submissions/.
server/.classes/

# ---------- Local-only conveniences kept on disk, never in the repo ----------
# The two run.bat shortcuts hard-code an absolute path (D:\Dev\PRM393-mobile\
# srs-review-ai\...) and log to *.log (already ignored), so committing them
# would hand every clone a broken path. Kept as local shortcuts by owner
# decision 2026-09-27. The root-level *.mp4 is a screen capture (21.2 MB); the
# owner chose to keep it for reference, so it is ignored rather than deleted —
# root scope only, so a video inside a docs folder can still be committed.
/*.mp4
/app/run.bat
/server/run_server.bat

# 2026-09-30: a self-contained diagram gallery belonging to another project sat
# in the repo root — RAG-edu (15 diagrams, 9.1 MB of base64), built by
# scripts/build-diagram-gallery.py from docs/diagrams/*.drawio. Neither the
# script nor the source directory exists in this repo, and D:\Dev\RAG-edu has
# no such path either, so committing it would add an unreproducible 9.1 MB blob
# to srs-review-ai's history for a different project's deliverable. Same posture
# as the root *.mp4 and skills.zip above: kept on disk, out of the index. Root
# scope on purpose, so a gallery inside a docs folder can still be committed.
/diagram-gallery.html
