rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny by default: every path is closed unless a rule below opens it.
    match /{document=**} {
      allow read, write: if false;
    }

    // A user may only read and write their own profile.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Signed-in users may read and write top-level documents.
    match /documents/{documentId} {
      allow read, write: if request.auth != null;
    }
  }
}
