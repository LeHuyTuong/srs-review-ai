rules_version = '2';

// Security Rules cho Lab 3 — nguồn sự thật về quyền, không phải UI.
// Mọi bản ghi thuộc về request.auth.uid; Admin đọc được nhưng không ghi thay người khác.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Admin được xác định bằng document admins/{uid} tạo từ Console.
    // Không dùng users.role: người dùng tự tạo được profile nên không tin được.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isServerTime(value) {
      return value == request.time;
    }

    function userKeys() {
      return ['uid', 'email', 'displayName', 'photoUrl', 'role',
              'lastSignInAt', 'createdAt', 'fcmTokens'];
    }

    // Client không được tự đổi role. Ngoại lệ duy nhất: profile cũ chưa có role
    // được gán mặc định 'teacher', khớp writer AuthService._syncUserProfile
    // (mobile/lib/services/auth_service.dart) chỉ ghi role khi chưa có.
    // Quyền admin thật nằm ở admins/{uid}, không ở users.role.
    function roleKeptOrDefaulted() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        || (!('role' in resource.data) && request.resource.data.role == 'teacher');
    }

    function projectKeys() {
      return ['name', 'description', 'status', 'ownerUid', 'schemaVersion', 'createdAt', 'updatedAt'];
    }

    function validProjectBody(userId) {
      return request.resource.data.keys().hasOnly(projectKeys())
        && request.resource.data.ownerUid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.status in ['active', 'archived']
        && request.resource.data.schemaVersion == 1;
    }

    // Chỉ Console/Admin SDK ghi được; client chỉ đọc document của chính mình.
    match /admins/{adminUid} {
      allow read: if signedIn() && request.auth.uid == adminUid;
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly(userKeys())
        && request.resource.data.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'teacher');
      allow update: if isSelf(userId)
        && request.resource.data.keys().hasOnly(userKeys())
        && request.resource.data.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt'])
        && roleKeptOrDefaulted();
      allow delete: if false;

      // Entity chính của Lab 3: dự án của chính người dùng đang đăng nhập.
      match /projects/{projectId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if isSelf(userId)
          && validProjectBody(userId)
          && isServerTime(request.resource.data.createdAt)
          && isServerTime(request.resource.data.updatedAt);
        allow update: if isSelf(userId)
          && validProjectBody(userId)
          && request.resource.data.createdAt == resource.data.createdAt
          && isServerTime(request.resource.data.updatedAt);
        allow delete: if isSelf(userId);
      }
    }

    // Bản mirror để Admin Web đọc; Crashlytics không có API đọc cho client.
    match /crash_logs/{logId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'logId', 'userId', 'type', 'message',
          'timestamp', 'stackTrace', 'deviceInfo', 'reason', 'appVersion'
        ])
        && request.resource.data.timestamp == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Metadata tệp SRS. File nằm trên Cloudinary; row này CHỈ server FastAPI ghi
    // qua Firebase Admin SDK (bỏ qua Rules) sau khi đã hỏi Cloudinary xác nhận
    // tệp: server/app/api/assets.py (POST /assets/{id}/finalize). Client gọi
    // server, không tự tạo/sửa row.
    // Reader: Admin Web SrsReportsRepository (orderBy uploadedAt desc) — cần isAdmin().
    // ownerUid chỉ có khi upload từ mobile (desktop chưa có Firebase login).
    // Tên collection: assets (Plan 13 §2.4; trước đây là srs_reports).
    match /assets/{assetId} {
      allow read: if signedIn()
        && (resource.data.get('ownerUid', '') == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Metadata báo cáo PDF sau khi upload Cloudinary (không lưu bytes trong Firestore).
    // Hiện CHƯA có writer/reader nào trong source dùng collection này; đây là
    // đích của Plan 13. Giữ nguyên tới WP2.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Đóng mọi đường chưa khai báo ở trên.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
