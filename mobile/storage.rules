rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Deny by default: every path is closed unless a rule below opens it.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // A user may only access their own report files.
    match /reports/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
