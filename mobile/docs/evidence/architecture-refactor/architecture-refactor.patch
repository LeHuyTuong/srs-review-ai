+      'course': c.courseId,
+      'status': c.state,
+      'schedule': c.schedule,
+      'session': c.session,
+    };
+    if (fields.entries.any(
+      (e) =>
+          state.values(e.key).isNotEmpty &&
+          !state.values(e.key).contains(e.value),
+    )) {
+      return false;
+    }
+    final course = s.course(c.courseId);
+    return '${c.code} ${course?.code} ${course?.name}'.toLowerCase().contains(
+      state.q.trim().toLowerCase(),
+    );
+  }).toList();
+}
