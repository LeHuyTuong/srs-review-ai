+class StudentDirectoryViewModel extends Notifier<AcademicRecord> {
+  @override
+  AcademicRecord build() {
+    ref.watch(sessionScopeProvider);
+    return AcademicRecord({
+      'semester': '',
+      'course': '',
+      'class': '',
+      'query': '',
+    });
