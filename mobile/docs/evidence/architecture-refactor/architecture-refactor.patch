+// Điều phối dữ liệu và kiểm tra biểu mẫu; Widget không tự áp dụng quy tắc hoặc ghi kho.
+class AcademicFormViewModel extends Notifier<AcademicFormState> {
+  Iterable<AcademicField> get dateFields =>
