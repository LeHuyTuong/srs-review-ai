+        ),
+        AcademicField(
+          'documentType',
+          'Loại tài liệu',
+          type: 'selectCustom',
+          options: {
+            for (final type in {
+              'Use Case Diagram',
+              'Activity Diagram',
+              'Sequence Diagram',
+              'State Diagram',
+              'Class Diagram',
+              'SRS',
+              'SDS',
