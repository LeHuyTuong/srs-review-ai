+                c.courseId == state.text('course')),
+      )
+      .toList();
+  List<Course> get courses => snapshot.courses
+      .where(
+        (c) =>
+            state.text('semester').isEmpty ||
+            snapshot.classes.any(
+              (cls) =>
+                  cls.semesterId == state.text('semester') &&
