+        const AcademicField(
+          'aiReview',
+          'Đánh giá AI',
+          type: 'chips',
+          options: {
+            'required': 'Bắt buộc',
+            'optional': 'Tùy chọn',
+            'disabled': 'Tắt',
+          },
+        ),
+        const AcademicField(
+          'supervisorReview',
+          'Giảng viên đánh giá',
+          type: 'chips',
+          options: {'required': 'Bắt buộc', 'optional': 'Tùy chọn'},
+        ),
+        const AcademicField(
+          'deadline',
+          'Hạn nộp riêng',
+          type: 'datetime',
+          hint: 'Không bắt buộc · ghi đè hạn nộp của Lab.',
+        ),
+        AcademicField(
+          'dependsOn',
+          'Phụ thuộc · cần được phê duyệt trước (AND)',
+          type: 'multi',
+          options: {
+            for (final i
+                in (s.offering(spec.offeringId)?.labs ?? [])
+                    .expand((l) => l.items)
