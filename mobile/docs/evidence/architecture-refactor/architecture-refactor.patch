+                    q: widget.initial.q,
+                    facets: ref.read(filterDraftProvider(draftSpec)),
+                  ),
+                );
+                Navigator.pop(context);
+              },
+            ),
+          ),
+        ],
+      ),
+      children: [
+        for (final f in [
+          AcademicField(
