+          hint: 'Gợi ý tự động, có thể sửa',
+        ),
+        const AcademicField('title', 'Tên nội dung'),
+        const AcademicField(
+          'deliverableType',
+          'Loại sản phẩm',
+          type: 'chips',
+          options: {
+            'Document': 'Tài liệu',
