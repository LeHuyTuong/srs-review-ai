        <mxCell id="3" value="&amp;lt;pre&amp;gt;%%{init: {&amp;#x27;theme&amp;#x27;: &amp;#x27;base&amp;#x27;, &amp;#x27;themeVariables&amp;#x27;: {&amp;#x27;primaryColor&amp;#x27;: &amp;#x27;#EDF6F0&amp;#x27;, &amp;#x27;primaryTextColor&amp;#x27;: &amp;#x27;#17324D&amp;#x27;, &amp;#x27;primaryBorderColor&amp;#x27;: &amp;#x27;#315C7D&amp;#x27;, &amp;#x27;lineColor&amp;#x27;: &amp;#x27;#526575&amp;#x27;, &amp;#x27;secondaryColor&amp;#x27;: &amp;#x27;#F7F3E8&amp;#x27;, &amp;#x27;tertiaryColor&amp;#x27;: &amp;#x27;#FFFFFF&amp;#x27;, &amp;#x27;fontSize&amp;#x27;: &amp;#x27;13px&amp;#x27;}}}%%&#10;sequenceDiagram&#10;    autonumber&#10;    actor User as Người dùng&#10;    participant UI as Flutter UI&#10;    participant VM as WorkspaceViewModel&#10;    participant Repo as DocumentRepository&#10;    participant Picker as FilePickerService&#10;    participant Parser as ParseService&#10;    participant Split as RequirementSplitter&#10;    participant Checks as SyllabusChecks + ReferenceChecks + ContradictionPass&#10;    participant Store as SessionStore&#10;&#10;    User-&amp;gt;&amp;gt;UI: Chọn PDF hoặc DOCX&#10;    UI-&amp;gt;&amp;gt;VM: importDocument()&#10;    VM-&amp;gt;&amp;gt;Repo: pickAndParse(onStatus)&#10;    Repo-&amp;gt;&amp;gt;Picker: pickSrsFile()&#10;    alt người dùng hủy&#10;        Picker--&amp;gt;&amp;gt;Repo: null&#10;        Repo--&amp;gt;&amp;gt;VM: null&#10;        VM--&amp;gt;&amp;gt;UI: Giữ workspace hiện tại, sẵn sàng&#10;    else chọn file hợp lệ&#10;        Picker--&amp;gt;&amp;gt;Repo: fileName + bytes + size + path&#10;        Repo-&amp;gt;&amp;gt;Parser: parse(fileName, bytes)&#10;        activate Parser&#10;        Parser-&amp;gt;&amp;gt;Split: split(pageTexts)&#10;        alt PDF&#10;            Split--&amp;gt;&amp;gt;Parser: RequirementItem[] + page indexes&#10;            Parser--&amp;gt;&amp;gt;Repo: SrsDocument&#10;        else DOCX&#10;            Split--&amp;gt;&amp;gt;Parser: RequirementItem[] + logical page 0&#10;            Parser--&amp;gt;&amp;gt;Repo: SrsDocument&#10;        end&#10;        deactivate Parser&#10;        Repo-&amp;gt;&amp;gt;Checks: runAll(document)&#10;        Checks--&amp;gt;&amp;gt;Repo: deterministic findings&#10;        Repo--&amp;gt;&amp;gt;VM: LoadedDocument&#10;        VM-&amp;gt;&amp;gt;VM: build inventory + findings + mode&#10;        VM-&amp;gt;&amp;gt;Store: saveSnapshot()&#10;        Store--&amp;gt;&amp;gt;VM: persisted&#10;        VM--&amp;gt;&amp;gt;UI: workspace ready&#10;    else file lỗi&#10;        Picker--&amp;gt;&amp;gt;Repo: ParseException&#10;        Repo--&amp;gt;&amp;gt;VM: error&#10;        VM--&amp;gt;&amp;gt;UI: hiển thị lý do&#10;    end&#10;&amp;lt;/pre&amp;gt;" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;visible=0;" vertex="1" parent="1">
