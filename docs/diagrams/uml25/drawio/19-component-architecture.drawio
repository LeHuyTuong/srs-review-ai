        <mxCell id="3" value="&amp;lt;pre&amp;gt;@startuml&#10;!include /Volumes/SSD/Dev/active/PRM392_FlutterMobile/diagrams-agent/style.iuml&#10;&#10;rectangle &amp;quot;Flutter app&amp;quot; as App {&#10;  component &amp;quot;Workspace UI&amp;quot; as UI&#10;  component &amp;quot;WorkspaceViewModel&amp;quot; as VM&#10;  component &amp;quot;DocumentRepository&amp;quot; as Doc&#10;  component &amp;quot;ReviewRepository&amp;quot; as Repo&#10;  component &amp;quot;VisionReviewService&amp;quot; as Vision&#10;  component &amp;quot;AskDocument&amp;quot; as Ask&#10;  component &amp;quot;ReportExporter&amp;quot; as Export&#10;  component &amp;quot;SessionStore&amp;quot; as Store&#10;  component &amp;quot;PageImageSelector&amp;quot; as Selector&#10;  component &amp;quot;PageImageRenderer&amp;quot; as Renderer&#10;  component &amp;quot;UploadService&amp;quot; as Upload&#10;  interface &amp;quot;ReviewApi&amp;quot; as IApi&#10;  component &amp;quot;ApiService&amp;quot; as Api&#10;  component &amp;quot;MockReviewApi&amp;quot; as Mock&#10;}&#10;&#10;rectangle &amp;quot;FastAPI proxy&amp;quot; as Proxy {&#10;  component &amp;quot;REST routes&amp;quot; as Routes&#10;  component &amp;quot;Auth + bounds&amp;quot; as Guard&#10;  database &amp;quot;Review cache&amp;quot; as ReviewCache&#10;  database &amp;quot;Diagram cache&amp;quot; as DiagramCache&#10;  component &amp;quot;RateLimiter&amp;quot; as Limit&#10;  component &amp;quot;QuoteVerifier&amp;quot; as Verify&#10;  component &amp;quot;ProviderRouter&amp;quot; as Router&#10;  database &amp;quot;ShareStore&amp;quot; as Share&#10;  database &amp;quot;UploadStore&amp;quot; as UploadStore&#10;}&#10;&#10;component &amp;quot;Gemini API&amp;quot; as Gemini&#10;database &amp;quot;SharedPreferences&amp;quot; as Prefs&#10;database &amp;quot;server/.shares&amp;quot; as Shares&#10;database &amp;quot;server/.uploads&amp;quot; as Uploads&#10;&#10;UI ..&amp;gt; VM : commands + state&#10;VM ..&amp;gt; Doc : import&#10;VM ..&amp;gt; Repo : review&#10;VM ..&amp;gt; Vision : audit&#10;VM ..&amp;gt; Ask : hỏi&#10;VM ..&amp;gt; Export : xuất&#10;VM ..&amp;gt; Store : lưu&#10;Repo ..&amp;gt; Selector : lập kế hoạch ảnh&#10;Repo ..&amp;gt; Renderer : render&#10;Vision ..&amp;gt; Renderer : render&#10;Vision ..&amp;gt; IApi : diagramAudit&#10;Ask ..&amp;gt; IApi : ask&#10;Repo ..&amp;gt; IApi : uses&#10;Api ..|&amp;gt; IApi : implements&#10;Mock ..|&amp;gt; IApi : implements&#10;Api --&amp;gt; Routes : HTTPS&#10;Mock ..&amp;gt; Routes : không gọi&#10;Routes ..&amp;gt; Guard : auth + bounds&#10;ReviewCache ..&amp;gt; Guard : lookup trước&#10;DiagramCache ..&amp;gt; Guard : lookup trước&#10;ReviewCache ..&amp;gt; Limit : miss&#10;DiagramCache ..&amp;gt; Limit : miss&#10;Limit ..&amp;gt; Router : 50/ngày&#10;Router ..&amp;gt; Gemini : primary + fallback&#10;Routes ..&amp;gt; Verify : review/ask&#10;Routes ..&amp;gt; Share : /share&#10;Routes ..&amp;gt; UploadStore : groundwork&#10;Upload ..&amp;gt; Routes : presign + PUT&#10;Share --&amp;gt; Shares : HTML&#10;UploadStore --&amp;gt; Uploads : raw bytes&#10;Store --&amp;gt; Prefs : snapshot + history&#10;Upload ..&amp;gt; VM : chưa có caller&#10;&#10;note bottom of App&#10;  MockReviewApi là client offline;&#10;  server MockProvider chỉ chạy nếu request tới proxy.&#10;end note&#10;@enduml&#10;&amp;lt;/pre&amp;gt;" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;visible=0;" vertex="1" parent="1">
