        <mxCell id="3" value="&amp;lt;pre&amp;gt;%%{init: {&amp;#x27;theme&amp;#x27;: &amp;#x27;base&amp;#x27;, &amp;#x27;themeVariables&amp;#x27;: {&amp;#x27;primaryColor&amp;#x27;: &amp;#x27;#EDF6F0&amp;#x27;, &amp;#x27;primaryTextColor&amp;#x27;: &amp;#x27;#17324D&amp;#x27;, &amp;#x27;primaryBorderColor&amp;#x27;: &amp;#x27;#315C7D&amp;#x27;, &amp;#x27;lineColor&amp;#x27;: &amp;#x27;#526575&amp;#x27;, &amp;#x27;secondaryColor&amp;#x27;: &amp;#x27;#F7F3E8&amp;#x27;, &amp;#x27;tertiaryColor&amp;#x27;: &amp;#x27;#FFFFFF&amp;#x27;, &amp;#x27;fontSize&amp;#x27;: &amp;#x27;13px&amp;#x27;}}}%%&#10;sequenceDiagram&#10;    autonumber&#10;    actor User as Người dùng&#10;    participant UI as Giao diện Flutter&#10;    participant VM as WorkspaceViewModel&#10;    participant Exporter as ReportExporter&#10;    participant Repo as ReviewRepository&#10;    participant API as ApiService&#10;    participant Proxy as FastAPI /share&#10;    participant Store as ShareStore&#10;    participant OS as Hệ điều hành&#10;&#10;    User-&amp;gt;&amp;gt;UI: Export Markdown/JSON/HTML&#10;    UI-&amp;gt;&amp;gt;VM: exportMarkdown / exportJson / exportHtml&#10;    VM-&amp;gt;&amp;gt;VM: Dựng ba bản báo cáo từ cùng một state&#10;    VM-&amp;gt;&amp;gt;Exporter: save(fileName, contents, mimeType)&#10;    Exporter-&amp;gt;&amp;gt;OS: Mở hộp thoại lưu file&#10;    OS--&amp;gt;&amp;gt;Exporter: người dùng chọn đích&#10;    Exporter--&amp;gt;&amp;gt;VM: đường dẫn đã lưu&#10;    VM--&amp;gt;&amp;gt;UI: đã lưu&#10;&#10;    User-&amp;gt;&amp;gt;UI: Share native&#10;    UI-&amp;gt;&amp;gt;VM: shareReport()&#10;    alt web&#10;        VM--&amp;gt;&amp;gt;UI: Chỉ lưu file, share sheet không khả dụng&#10;    else mobile/desktop&#10;        VM-&amp;gt;&amp;gt;Exporter: share(fileName, markdown)&#10;        Exporter-&amp;gt;&amp;gt;OS: Mở share sheet&#10;        OS--&amp;gt;&amp;gt;VM: người dùng hoàn tất thao tác&#10;    end&#10;&#10;    User-&amp;gt;&amp;gt;UI: Tạo liên kết chia sẻ&#10;    UI-&amp;gt;&amp;gt;VM: mintShareLink()&#10;    alt mock mode&#10;        VM--&amp;gt;&amp;gt;UI: Liên kết không khả dụng&#10;    else trực tuyến&#10;        VM-&amp;gt;&amp;gt;VM: exportHtml()&#10;        VM-&amp;gt;&amp;gt;Repo: shareReport(html, fileName)&#10;        Repo-&amp;gt;&amp;gt;API: POST /share&#10;        API-&amp;gt;&amp;gt;Proxy: HTML + X-App-Token + X-User-Id&#10;        Proxy-&amp;gt;&amp;gt;Proxy: kiểm tra HTML ≤ 4 MiB&#10;        Proxy-&amp;gt;&amp;gt;Store: put(html)&#10;        Store--&amp;gt;&amp;gt;Proxy: capability id&#10;        Proxy--&amp;gt;&amp;gt;API: /share/&amp;lt;id&amp;gt;&#10;        API--&amp;gt;&amp;gt;Repo: URL tuyệt đối&#10;        Repo--&amp;gt;&amp;gt;VM: share link&#10;        VM--&amp;gt;&amp;gt;UI: liên kết đã tạo&#10;    end&#10;    Note over Proxy,Store: Share không có expiry/delete, URL ngẫu nhiên là read credential.&#10;&amp;lt;/pre&amp;gt;" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;visible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="10" height="10" as="geometry">
            <mxRectangle x="40" y="40" width="10" height="10" as="alternateBounds" />
          </mxGeometry>
