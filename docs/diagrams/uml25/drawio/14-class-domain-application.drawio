        <mxCell id="3" value="&amp;lt;pre&amp;gt;%%{init: {&amp;#x27;theme&amp;#x27;: &amp;#x27;base&amp;#x27;, &amp;#x27;themeVariables&amp;#x27;: {&amp;#x27;primaryColor&amp;#x27;: &amp;#x27;#FFFFFF&amp;#x27;, &amp;#x27;primaryTextColor&amp;#x27;: &amp;#x27;#1A1A1A&amp;#x27;, &amp;#x27;primaryBorderColor&amp;#x27;: &amp;#x27;#333333&amp;#x27;, &amp;#x27;lineColor&amp;#x27;: &amp;#x27;#444444&amp;#x27;, &amp;#x27;secondaryColor&amp;#x27;: &amp;#x27;#FAF6E0&amp;#x27;, &amp;#x27;tertiaryColor&amp;#x27;: &amp;#x27;#FFFFFF&amp;#x27;, &amp;#x27;fontSize&amp;#x27;: &amp;#x27;11px&amp;#x27;}}}%%&#10;classDiagram&#10;    direction LR&#10;&#10;    class SrsDocument {&#10;        +String fileName&#10;        +int pageCount&#10;        +List~String~ pageTexts&#10;        +List~RequirementItem~ requirements&#10;        +List~String~ occurrenceKeys&#10;        +List~int~ imagePageIndexes&#10;        +String documentFingerprint&#10;        +int useCaseCount&#10;    }&#10;    class RequirementItem {&#10;        +String id&#10;        +String text&#10;        +RequirementKind kind&#10;        +String? section&#10;        +int? pageIndex&#10;        +bool isUseCase&#10;    }&#10;    class RequirementKind {&#10;        &amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&#10;        functional&#10;        useCase&#10;        statement&#10;    }&#10;    class LoadedDocument {&#10;        +SrsDocument document&#10;        +List~DeterministicFinding~ findings&#10;        +List~DeterministicFinding~ referenceFindings&#10;        +int sizeBytes&#10;        +String? path&#10;        +Uint8List? pdfBytes&#10;        +Iterable~DeterministicFinding~ allFindings&#10;    }&#10;    class WorkspaceUnit {&#10;        +String key&#10;        +String id&#10;        +String title&#10;        +String text&#10;        +String? section&#10;        +int pageIndex&#10;        +bool malformed&#10;        +bool selected&#10;        +UnitStatus status&#10;        +UnitKind kind&#10;        +WorkspaceUnit copyWith(...)&#10;        +WorkspaceUnit classified(UnitKind)&#10;    }&#10;    class UnitKind {&#10;        &amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&#10;        useCase&#10;        businessRule&#10;        nonFunctional&#10;        functional&#10;        unknown&#10;    }&#10;    class UnitStatus {&#10;        &amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&#10;        pending&#10;        reviewed&#10;        failed&#10;        skipped&#10;    }&#10;    class DeterministicFinding {&#10;        +CheckId check&#10;        +bool passed&#10;        +Severity severity&#10;        +String message&#10;        +String? subject&#10;        +num? actual&#10;        +num? expectedMin&#10;        +num? expectedMax&#10;        +bool requiresVisionEvidence&#10;        +String ledgerKey&#10;    }&#10;    class CheckId {&#10;        &amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&#10;        ucCount&#10;        language&#10;        ucSize&#10;        duplicateIds&#10;        missingPostcondition&#10;        crossArtifactName&#10;        missingActor&#10;        ambiguousWording&#10;        placeholderTbd&#10;        diagramAudit&#10;        missingPriority&#10;        nfrUnquantified&#10;    }&#10;    class FindingStatus {&#10;        &amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&#10;        open&#10;        fixed&#10;        verified&#10;        pendingVision&#10;        disputed&#10;    }&#10;    class ReviewRun {&#10;        +Map~String, ReviewResult~ results&#10;        +Map~String, String~ failures&#10;        +Map~String, String~ failureRequirementIds&#10;        +ReviewStage stage&#10;        +int skipped&#10;        +PageImageCoverage imageCoverage&#10;    }&#10;    class ReviewResult {&#10;        +String requirementId&#10;        +int score&#10;        +List~ReviewIssue~ issues&#10;        +String? contextNote&#10;        +int droppedIssueCount&#10;        +String model&#10;        +bool cached&#10;        +bool mock&#10;    }&#10;    class ReviewIssue {&#10;        +IssueType type&#10;        +Severity severity&#10;        +String quote&#10;        +String suggestion&#10;        +Verification verification&#10;        +double? similarity&#10;    }&#10;    class ReviewProgress {&#10;        +ReviewStage stage&#10;        +int completed&#10;        +int total&#10;        +String? currentRequirementId&#10;        +String? error&#10;        +int skipped&#10;        +double fraction&#10;    }&#10;    class ReviewStage {&#10;        &amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&#10;        idle&#10;        parsing&#10;        reviewing&#10;        verifying&#10;        done&#10;        cancelled&#10;        failed&#10;    }&#10;    class PageImageCoverage {&#10;        +int candidates&#10;        +int extracted&#10;        +int reviewed&#10;        +int skipped&#10;        +int failed&#10;        +Map~String, int~ reasons&#10;        +Map~String, int~ decisions&#10;        +Set~String~ reviewedOccurrenceKeys&#10;    }&#10;    class DiagramAuditRequest {&#10;        +int pageIndex&#10;        +String diagramType&#10;        +String contextText&#10;        +String imageB64&#10;    }&#10;    class DiagramAuditResult {&#10;        +int pageIndex&#10;        +String diagramType&#10;        +List~String~ elements&#10;        +List~DiagramRelationData~ relations&#10;        +List~String~ unreadable&#10;        +bool clean&#10;        +List~DiagramFindingData~ findings&#10;        +String model&#10;        +bool cached&#10;        +bool mock&#10;    }&#10;    class DiagramRelationData {&#10;        +String source&#10;        +String target&#10;        +String label&#10;        +String arrowheadSide&#10;    }&#10;    class DiagramFindingData {&#10;        +String family&#10;        +String entity&#10;        +String evidence&#10;        +String severity&#10;    }&#10;    class AskOutcome {&#10;        +AskEngine engine&#10;        +String answer&#10;        +bool grounded&#10;        +List~WorkspaceUnit~ units&#10;        +List~Citation~ citations&#10;        +String? model&#10;        +String? note&#10;    }&#10;    class AskEngine {&#10;        &amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&#10;        offlineSearch&#10;        model&#10;    }&#10;    class Citation {&#10;        +String quote&#10;        +Verification verification&#10;        +int? pageIndex&#10;    }&#10;    class SavedSession {&#10;        +String id&#10;        +String fileName&#10;        +String payloadJson&#10;        +DateTime createdAt&#10;        +String fingerprint&#10;        +String parserVersion&#10;    }&#10;    class SessionStore {&#10;        &amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&#10;        +Future~List~SavedSession~~ list()&#10;        +Future~void~ save(SavedSession)&#10;        +Future~SavedSession?~ open(String)&#10;        +Future~void~ delete(String)&#10;        +Future~String?~ loadSnapshot()&#10;        +Future~void~ saveSnapshot(String)&#10;        +Future~void~ clearSnapshot()&#10;    }&#10;    class InMemorySessionStore&#10;    class SharedPreferencesSessionStore&#10;    class ReviewApi {&#10;        &amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&#10;        +Future~bool~ isProxyUp()&#10;        +Future~RubricConfig~ fetchRubric()&#10;        +Future~ReviewResult~ review(...)&#10;        +Future~DiagramAuditResult~ diagramAudit(...)&#10;        +Future~String~ shareReport(...)&#10;        +Future~AskResponse~ ask(...)&#10;    }&#10;    class ApiService&#10;    class MockReviewApi&#10;    class ReviewRepository&#10;    class VisionReviewService&#10;    class PageImageSelector&#10;    class ImageBudget&#10;    class PageImageRenderer&#10;    class DiagramDetector&#10;    class DiagramTypeClassifier&#10;    class DocumentRepository&#10;    class ParseService&#10;    class ReportExporter&#10;    class WorkspaceViewModel&#10;    class WorkspaceReviewResult&#10;    class FindingRow&#10;    class Verifier&#10;&#10;    SrsDocument &amp;quot;1&amp;quot; o-- &amp;quot;0..*&amp;quot; RequirementItem : contains&#10;    SrsDocument &amp;quot;1&amp;quot; o-- &amp;quot;0..*&amp;quot; WorkspaceUnit : inventory&#10;    LoadedDocument *-- SrsDocument : document&#10;    LoadedDocument &amp;quot;1&amp;quot; o-- &amp;quot;0..*&amp;quot; DeterministicFinding : findings&#10;    LoadedDocument &amp;quot;1&amp;quot; o-- &amp;quot;0..*&amp;quot; DeterministicFinding : referenceFindings&#10;    RequirementItem --&amp;gt; RequirementKind : kind&#10;    WorkspaceUnit --&amp;gt; UnitKind : kind&#10;    WorkspaceUnit --&amp;gt; UnitStatus : status&#10;    DeterministicFinding --&amp;gt; CheckId : check&#10;    DeterministicFinding --&amp;gt; Severity : severity&#10;    ReviewRun &amp;quot;1&amp;quot; o-- &amp;quot;0..*&amp;quot; ReviewResult : results&#10;    ReviewRun &amp;quot;1&amp;quot; o-- &amp;quot;0..1&amp;quot; PageImageCoverage : imageCoverage&#10;    ReviewResult &amp;quot;1&amp;quot; o-- &amp;quot;0..*&amp;quot; ReviewIssue : issues&#10;    ReviewIssue --&amp;gt; IssueType : type&#10;    ReviewIssue --&amp;gt; Severity : severity&#10;    ReviewIssue --&amp;gt; Verification : verification&#10;    ReviewProgress --&amp;gt; ReviewStage : stage&#10;    DiagramAuditResult &amp;quot;1&amp;quot; o-- &amp;quot;0..*&amp;quot; DiagramRelationData : relations&#10;    DiagramAuditResult &amp;quot;1&amp;quot; o-- &amp;quot;0..*&amp;quot; DiagramFindingData : findings&#10;    AskOutcome --&amp;gt; AskEngine : engine&#10;    AskOutcome &amp;quot;1&amp;quot; o-- &amp;quot;0..*&amp;quot; WorkspaceUnit : passages&#10;    AskOutcome &amp;quot;1&amp;quot; o-- &amp;quot;0..*&amp;quot; Citation : citations&#10;    SessionStore &amp;quot;1&amp;quot; o-- &amp;quot;0..*&amp;quot; SavedSession : history&#10;    InMemorySessionStore ..|&amp;gt; SessionStore : implements&#10;    SharedPreferencesSessionStore ..|&amp;gt; SessionStore : implements&#10;    ApiService ..|&amp;gt; ReviewApi : implements&#10;    MockReviewApi ..|&amp;gt; ReviewApi : implements&#10;    ReviewRepository ..&amp;gt; ReviewApi : uses&#10;    ReviewRepository ..&amp;gt; PageImageSelector : plans&#10;    ReviewRepository ..&amp;gt; ImageBudget : bounds&#10;    ReviewRepository ..&amp;gt; PageImageRenderer : renders&#10;    VisionReviewService ..&amp;gt; ReviewApi : audits&#10;    VisionReviewService ..&amp;gt; PageImageRenderer : renders&#10;    VisionReviewService ..&amp;gt; DiagramDetector : detects&#10;    VisionReviewService ..&amp;gt; DiagramTypeClassifier : classifies&#10;    DocumentRepository ..&amp;gt; ParseService : uses&#10;    WorkspaceViewModel ..&amp;gt; DocumentRepository : imports&#10;    WorkspaceViewModel ..&amp;gt; ReviewRepository : reviews&#10;    WorkspaceViewModel ..&amp;gt; VisionReviewService : audits&#10;    WorkspaceViewModel ..&amp;gt; SessionStore : persists&#10;    WorkspaceViewModel ..&amp;gt; ReportExporter : exports&#10;    WorkspaceViewModel ..&amp;gt; SrsDocument : owns current&#10;    Verifier ..&amp;gt; FindingStatus : transitions&#10;&#10;    Note right of ReviewResult: contextNote không ảnh hưởng score.&#10;    Note right of LoadedDocument: pdfBytes chỉ tồn tại trong phiên, không serialize.&#10;&amp;lt;/pre&amp;gt;" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;visible=0;" vertex="1" parent="1">
