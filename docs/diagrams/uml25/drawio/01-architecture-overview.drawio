        <mxCell id="3" value="&amp;lt;pre&amp;gt;%%{init: {&amp;#x27;theme&amp;#x27;: &amp;#x27;base&amp;#x27;, &amp;#x27;themeVariables&amp;#x27;: {&amp;#x27;primaryColor&amp;#x27;: &amp;#x27;#EDF6F0&amp;#x27;, &amp;#x27;primaryTextColor&amp;#x27;: &amp;#x27;#17324D&amp;#x27;, &amp;#x27;primaryBorderColor&amp;#x27;: &amp;#x27;#315C7D&amp;#x27;, &amp;#x27;lineColor&amp;#x27;: &amp;#x27;#526575&amp;#x27;, &amp;#x27;secondaryColor&amp;#x27;: &amp;#x27;#F7F3E8&amp;#x27;, &amp;#x27;tertiaryColor&amp;#x27;: &amp;#x27;#FFFFFF&amp;#x27;, &amp;#x27;fontSize&amp;#x27;: &amp;#x27;14px&amp;#x27;}}}%%&#10;flowchart LR&#10;    subgraph USER[&amp;quot;Người dùng&amp;quot;]&#10;        U[&amp;quot;Sinh viên\nMở app, chọn file, chọn unit&amp;quot;]&#10;    end&#10;&#10;    subgraph APP[&amp;quot;Flutter app — app/lib&amp;quot;]&#10;        direction TB&#10;        UI[&amp;quot;Workspace UI\nView + Riverpod&amp;quot;]&#10;        VM[&amp;quot;WorkspaceViewModel\ntrạng thái + lệnh&amp;quot;]&#10;        DOC[&amp;quot;DocumentRepository&amp;quot;]&#10;        PARSE[&amp;quot;ParseService\nPDF/DOCX → SrsDocument&amp;quot;]&#10;        SPLIT[&amp;quot;RequirementSplitter&amp;quot;]&#10;        CHECK[&amp;quot;Kiểm tra tất định\nF7/F8/F9 + M2 + Quality&amp;quot;]&#10;        REV[&amp;quot;ReviewRepository\ncap = 60\nconcurrency mặc định = 4&amp;quot;]&#10;        API[&amp;quot;ReviewApi\nApiService hoặc MockReviewApi&amp;quot;]&#10;        MOCK[&amp;quot;MockReviewApi\nchạy offline, không mạng&amp;quot;]&#10;        IMAGESEL[&amp;quot;PageImageSelector\nImageBudget = 12&amp;quot;]&#10;        RENDER[&amp;quot;PageImageRenderer\nPNG → base64&amp;quot;]&#10;        VISION[&amp;quot;VisionReviewService\naudit riêng, tối đa 10 trang&amp;quot;]&#10;        ASK[&amp;quot;AskDocument\ntìm kiếm ngoại tuyến&amp;quot;]&#10;        EXPORT[&amp;quot;ReportExporter\nlưu / chia sẻ native&amp;quot;]&#10;        STORE[&amp;quot;SessionStore\nSharedPreferences&amp;quot;]&#10;        PREF[(&amp;quot;SharedPreferences\nsnapshot + history + settings&amp;quot;)]&#10;        UPLOAD[&amp;quot;UploadService\ngroundwork, chưa có caller&amp;quot;]&#10;    end&#10;&#10;    subgraph PROXY[&amp;quot;FastAPI proxy — server/app&amp;quot;]&#10;        direction TB&#10;        ROUTES[&amp;quot;REST routes\n/review /ask /diagram /share /uploads/*&amp;quot;]&#10;        AUTH[&amp;quot;X-App-Token\nX-User-Id&amp;quot;]&#10;        REVIEW_CACHE[(&amp;quot;Review cache\nLRU 512&amp;quot;)]&#10;        DIAGRAM_CACHE[(&amp;quot;Diagram cache\nLRU 512&amp;quot;)]&#10;        LIMIT[&amp;quot;RateLimiter\n50 logical requests/ngày&amp;quot;]&#10;        VERIFY[&amp;quot;QuoteVerifier\nexact/fuzzy ≥ 0,92&amp;quot;]&#10;        PROMPT[&amp;quot;Rubric + prompts\nstructured JSON&amp;quot;]&#10;        ROUTER[&amp;quot;ProviderRouter\nGemini 3.5 Flash-Lite\nfallback 3.1 Flash-Lite&amp;quot;]&#10;        UPLOAD_STORE[&amp;quot;UploadStore\npresign + PUT\n40 MiB&amp;quot;]&#10;        SHARE_STORE[&amp;quot;ShareStore\nHTML report&amp;quot;]&#10;    end&#10;&#10;    subgraph EXT[&amp;quot;Hạ tầng bên ngoài&amp;quot;]&#10;        GEMINI[&amp;quot;Gemini API&amp;quot;]&#10;        LOCAL[&amp;quot;Local storage\nserver/.uploads\nserver/.shares&amp;quot;]&#10;    end&#10;&#10;    U --&amp;gt;|chọn PDF/DOCX ≤ 30 MB| UI&#10;    UI --&amp;gt;|importDocument| VM&#10;    VM --&amp;gt; DOC&#10;    DOC --&amp;gt; PARSE&#10;    PARSE --&amp;gt; SPLIT&#10;    SPLIT --&amp;gt; CHECK&#10;    CHECK --&amp;gt;|LoadedDocument| VM&#10;    VM --&amp;gt;|inventory + selection| REV&#10;    REV --&amp;gt;|&amp;quot;review()&amp;quot;| API&#10;    API --&amp;gt;|online: HTTPS| ROUTES&#10;    API -.-&amp;gt;|mock mode: offline rules| MOCK&#10;    MOCK -.-&amp;gt; API&#10;&#10;    ROUTES --&amp;gt; AUTH&#10;    AUTH --&amp;gt; REVIEW_ROUTE[&amp;quot;/review&amp;quot;]&#10;    AUTH --&amp;gt; ASK_ROUTE[&amp;quot;/ask&amp;quot;]&#10;    AUTH --&amp;gt; DIAGRAM_ROUTE[&amp;quot;/diagram&amp;quot;]&#10;    AUTH --&amp;gt; SHARE_ROUTE[&amp;quot;/share&amp;quot;]&#10;    AUTH -.-&amp;gt; UPLOAD_ROUTE[&amp;quot;/uploads/*&amp;quot;]&#10;&#10;    REVIEW_ROUTE --&amp;gt; REVIEW_CACHE&#10;    REVIEW_CACHE --&amp;gt;|hit| REVIEW_RESULT[&amp;quot;ReviewResult&amp;quot;]&#10;    REVIEW_CACHE --&amp;gt;|miss| LIMIT&#10;    LIMIT --&amp;gt;|allowed| PROMPT&#10;    PROMPT --&amp;gt; ROUTER&#10;    ROUTER --&amp;gt; GEMINI&#10;    GEMINI --&amp;gt; VERIFY&#10;    VERIFY --&amp;gt;|kept issues only| REVIEW_CACHE&#10;    REVIEW_CACHE --&amp;gt; REVIEW_RESULT&#10;    REVIEW_RESULT --&amp;gt; ROUTES&#10;    ROUTES --&amp;gt;|ReviewResult| API&#10;    API --&amp;gt; REV&#10;    REV --&amp;gt;|progress/result| VM&#10;&#10;    ASK_ROUTE --&amp;gt; LIMIT&#10;    LIMIT --&amp;gt; ASK_PROMPT[&amp;quot;Ask prompt + bounded context&amp;quot;]&#10;    ASK_PROMPT --&amp;gt; ROUTER&#10;    ROUTER --&amp;gt; GEMINI&#10;    GEMINI --&amp;gt; VERIFY&#10;    VERIFY --&amp;gt;|grounded answer| ASK_ROUTE&#10;    ASK_ROUTE --&amp;gt;|AskResponse| API&#10;    API --&amp;gt; REV&#10;    REV --&amp;gt;|answer| VM&#10;&#10;    DIAGRAM_ROUTE --&amp;gt; DIAGRAM_CACHE&#10;    DIAGRAM_CACHE --&amp;gt;|hit| DIAGRAM_RESULT[&amp;quot;DiagramAuditResult&amp;quot;]&#10;    DIAGRAM_CACHE --&amp;gt;|miss| LIMIT&#10;    LIMIT --&amp;gt;|allowed| DESCRIBE[&amp;quot;Describe call 1&amp;quot;]&#10;    DESCRIBE --&amp;gt; JUDGE[&amp;quot;Judge call 2&amp;quot;]&#10;    JUDGE --&amp;gt;|one logical request| DIAGRAM_CACHE&#10;    DIAGRAM_CACHE --&amp;gt; DIAGRAM_RESULT&#10;    DIAGRAM_RESULT --&amp;gt; ROUTES&#10;    ROUTES --&amp;gt;|DiagramAuditResult| API&#10;    API --&amp;gt; VISION&#10;    VISION --&amp;gt;|ledger rows| VM&#10;&#10;    VM --&amp;gt;|askQuestion| ASK&#10;    ASK --&amp;gt;|no match: offline answer| VM&#10;    ASK --&amp;gt;|match + online| API&#10;    API --&amp;gt; ASK_ROUTE&#10;&#10;    VM --&amp;gt;|auditDiagrams| VISION&#10;    VISION --&amp;gt; RENDER&#10;    RENDER --&amp;gt;|PNG base64| VISION&#10;    VISION --&amp;gt;|diagramAudit| API&#10;    API --&amp;gt; DIAGRAM_ROUTE&#10;&#10;    VM --&amp;gt;|exportHtml / markdown / json| EXPORT&#10;    EXPORT --&amp;gt;|saveFile| U&#10;    EXPORT --&amp;gt;|native share Markdown| U&#10;    VM --&amp;gt;|mintShareLink| REV&#10;    REV --&amp;gt;|shareReport| API&#10;    API --&amp;gt; SHARE_ROUTE&#10;    SHARE_ROUTE --&amp;gt; SHARE_STORE&#10;    SHARE_STORE --&amp;gt; LOCAL&#10;    SHARE_STORE --&amp;gt;|capability id → URL tuyệt đối| VM&#10;&#10;    ROUTES -.-&amp;gt;|groundwork, chưa gọi từ import| UPLOAD_ROUTE&#10;    UPLOAD --&amp;gt; UPLOAD_ROUTE&#10;    UPLOAD_ROUTE --&amp;gt; UPLOAD_STORE&#10;    UPLOAD_STORE --&amp;gt; LOCAL&#10;&#10;    VM --&amp;gt; STORE&#10;    STORE --&amp;gt; PREF&#10;&#10;    classDef user fill:#F4EFF8,stroke:#76558B,color:#24172E;&#10;    classDef app fill:#EDF6F0,stroke:#315C7D,color:#17324D;&#10;    classDef proxy fill:#EEF2F7,stroke:#526E8B,color:#17324D;&#10;    classDef ext fill:#FFF7E5,stroke:#B1955B,color:#4A3A18;&#10;    class U user;&#10;    class UI,VM,DOC,PARSE,SPLIT,CHECK,REV,API,MOCK,IMAGESEL,RENDER,VISION,ASK,EXPORT,STORE,PREF,UPLOAD app;&#10;    class ROUTES,AUTH,REVIEW_ROUTE,ASK_ROUTE,DIAGRAM_ROUTE,SHARE_ROUTE,UPLOAD_ROUTE,REVIEW_CACHE,DIAGRAM_CACHE,LIMIT,VERIFY,PROMPT,ROUTER,UPLOAD_STORE,SHARE_STORE proxy;&#10;    class GEMINI,LOCAL ext;&#10;    class REVIEW_RESULT,DIAGRAM_RESULT proxy;&#10;&amp;lt;/pre&amp;gt;" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;visible=0;" vertex="1" parent="1">
