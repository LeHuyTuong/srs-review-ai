        <mxCell id="2" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;sourcePath=../11-sequence-ask.mmd;sourceFormat=mermaid;sourceHash=4580bda68293279aede559bda257fe25ada2273c38da335d625c880c87723744;description=Tuần tự hỏi tài liệu" vertex="1" parent="1" sourcePath="../11-sequence-ask.mmd" sourceFormat="mermaid" sourceHash="4580bda68293279aede559bda257fe25ada2273c38da335d625c880c87723744" description="Tuần tự hỏi tài liệu">
