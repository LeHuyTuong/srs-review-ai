        </mxCell>
        <mxCell id="3" value="&amp;lt;pre&amp;gt;%%{init: {&amp;#x27;theme&amp;#x27;: &amp;#x27;base&amp;#x27;, &amp;#x27;themeVariables&amp;#x27;: {&amp;#x27;primaryColor&amp;#x27;: &amp;#x27;#EDF6F0&amp;#x27;, &amp;#x27;primaryTextColor&amp;#x27;: &amp;#x27;#17324D&amp;#x27;, &amp;#x27;primaryBorderColor&amp;#x27;: &amp;#x27;#315C7D&amp;#x27;, &amp;#x27;lineColor&amp;#x27;: &amp;#x27;#526575&amp;#x27;, &amp;#x27;secondaryColor&amp;#x27;: &amp;#x27;#F7F3E8&amp;#x27;, &amp;#x27;tertiaryColor&amp;#x27;: &amp;#x27;#FFFFFF&amp;#x27;, &amp;#x27;fontSize&amp;#x27;: &amp;#x27;12px&amp;#x27;}}}%%&#10;sequenceDiagram&#10;    autonumber&#10;    actor User as Người dùng&#10;    participant UI as Giao diện Flutter&#10;    participant VM as WorkspaceViewModel&#10;    participant Vision as VisionReviewService&#10;    participant Detector as DiagramDetector&#10;    participant Classifier as DiagramTypeClassifier&#10;    participant Renderer as PageImageRenderer&#10;    participant API as ReviewApi&#10;    participant Http as ApiService&#10;    participant Proxy as FastAPI /diagram&#10;    participant Cache as Diagram cache&#10;    participant Limit as RateLimiter&#10;    participant Describe as Gemini Describe&#10;    participant Judge as Gemini Judge&#10;    participant Store as SessionStore&#10;&#10;    User-&amp;gt;&amp;gt;UI: Bấm Audit sơ đồ&#10;    UI-&amp;gt;&amp;gt;VM: auditDiagrams()&#10;    VM-&amp;gt;&amp;gt;VM: Yêu cầu PDF gốc còn trong bộ nhớ&#10;    VM-&amp;gt;&amp;gt;Vision: audit(document)&#10;    Vision-&amp;gt;&amp;gt;Detector: phát hiện trang có ảnh&#10;    Vision-&amp;gt;&amp;gt;Classifier: phân loại trang được gọi tên&#10;    Vision-&amp;gt;&amp;gt;Vision: Chọn named-first + visual-only, tối đa 10 trang&#10;    loop Mỗi trang trong ngân sách&#10;        Vision-&amp;gt;&amp;gt;Renderer: renderPage(pageIndex)&#10;        Renderer--&amp;gt;&amp;gt;Vision: PNG bytes&#10;        Vision-&amp;gt;&amp;gt;API: diagramAudit(page, type, context, image_b64)&#10;        API-&amp;gt;&amp;gt;Http: POST /diagram&#10;        Http-&amp;gt;&amp;gt;Proxy: request + X-App-Token + X-User-Id&#10;        Proxy-&amp;gt;&amp;gt;Cache: lookup(key đầy đủ)&#10;        alt cache hit&#10;            Cache--&amp;gt;&amp;gt;Proxy: DiagramAuditResult&#10;            Proxy--&amp;gt;&amp;gt;Http: result&#10;        else cache miss&#10;            Proxy-&amp;gt;&amp;gt;Limit: check(user, 50/ngày)&#10;            alt quota đã hết&#10;                Limit--&amp;gt;&amp;gt;Proxy: 429&#10;                Proxy--&amp;gt;&amp;gt;Http: 429&#10;                Http--&amp;gt;&amp;gt;API: lỗi&#10;                API--&amp;gt;&amp;gt;Vision: failure&#10;            else được phép&#10;                Limit--&amp;gt;&amp;gt;Proxy: allowed&#10;                Proxy-&amp;gt;&amp;gt;Describe: call 1: mô tả elements/relations&#10;                Describe--&amp;gt;&amp;gt;Proxy: DiagramDescribe&#10;                Proxy-&amp;gt;&amp;gt;Judge: call 2: chấm notation&#10;                Judge--&amp;gt;&amp;gt;Proxy: DiagramVerdict&#10;                Proxy-&amp;gt;&amp;gt;Proxy: bind family: DOC nếu không thấy inventory&#10;                Proxy-&amp;gt;&amp;gt;Cache: put(key đầy đủ, DiagramAuditResult)&#10;                Proxy--&amp;gt;&amp;gt;Http: DiagramAuditResult&#10;            end&#10;        end&#10;        Http--&amp;gt;&amp;gt;API: DiagramAuditResult&#10;        API--&amp;gt;&amp;gt;Vision: result hoặc failure&#10;        Vision-&amp;gt;&amp;gt;Vision: tạo đúng một ledger row cho trang&#10;    end&#10;    Vision--&amp;gt;&amp;gt;VM: findings + failures + skipped pages&#10;    VM-&amp;gt;&amp;gt;VM: Thay riêng các row diagramAudit, giữ family khác&#10;    VM-&amp;gt;&amp;gt;Store: saveSnapshot()&#10;    Store--&amp;gt;&amp;gt;VM: đã lưu&#10;    VM--&amp;gt;&amp;gt;UI: tóm tắt audit&#10;    Note over Proxy,Describe: Một trang = một logical request, dù có hai model call.&#10;    Note over Proxy,Judge: Diagram audit không dùng QuoteVerifier, lỗi audit không được ghi thành verdict sạch.&#10;&amp;lt;/pre&amp;gt;" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;visible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="10" height="10" as="geometry">
            <mxRectangle x="40" y="40" width="10" height="10" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
