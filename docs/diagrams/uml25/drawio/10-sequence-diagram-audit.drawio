        <mxCell id="2" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;sourcePath=../10-sequence-diagram-audit.mmd;sourceFormat=mermaid;sourceHash=7b17caa7dfcdde39307e612c35dadbc24ff028dab2067814c6495a131dcc1429;description=Tuần tự audit sơ đồ" vertex="1" parent="1" sourcePath="../10-sequence-diagram-audit.mmd" sourceFormat="mermaid" sourceHash="7b17caa7dfcdde39307e612c35dadbc24ff028dab2067814c6495a131dcc1429" description="Tuần tự audit sơ đồ">
          <mxGeometry x="40.0" y="40.0" width="1120.0" height="715.74" as="geometry">
            <mxRectangle x="40.0" y="40.0" width="1120.0" height="715.74" as="alternateBounds" />
