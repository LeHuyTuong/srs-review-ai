 requirementId PK&#10;        int score&#10;        List issues&#10;        string model&#10;        string contextNote&#10;        int droppedIssueCount&#10;        boolean cached&#10;        boolean mock&#10;    }&#10;    ReviewIssue {&#10;        IssueType type&#10;        Severity severity&#10;        string quote&#10;        string suggestion&#10;        Verification verification&#10;        double similarity&#10;    }&#10;    PageImageCoverage {&#10;        int candidates&#10;        int extracted&#10;        int reviewed&#10;        int skipped&#10;        int failed&#10;        json reasons&#10;        json decisions&#10;        string[] reviewedOccurrenceKeys&#10;    }&#10;    DiagramAuditResult {&#10;        int pageIndex PK&#10;        DiagramType diagramType&#10;        string[] elements&#10;        json relations&#10;        string[] unreadable&#10;        boolean clean&#10;        json findings&#10;        string model&#10;        boolean cached&#10;        boolean mock&#10;    }&#10;    AskOutcome {&#10;        AskEngine engine&#10;        string answer&#10;        boolean grounded&#10;        string model&#10;        string note&#10;    }&#10;    Citation {&#10;        string quote PK&#10;        Verification verification&#10;        int pageIndex&#10;    }&#10;    SavedSession {&#10;        string id PK&#10;        string fileName&#10;        string payloadJson&#10;        datetime createdAt&#10;        string fingerprint&#10;        string parserVersion&#10;    }&#10;    SessionStore {&#10;        int maxSessions&#10;    }&#10;&#10;    %% DiagramRelationData và DiagramFindingData là value objects lồng trong DiagramAuditResult,&#10;    %% không phải bảng độc lập. ReviewRun, AskOutcome và DiagramAuditResult là đối tượng phiên.&#10;&amp;lt;/pre&amp;gt;" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;visible=0;" vertex="1" parent="1">
